{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/max/**/route.ts": {
      "includeFiles": "certs/**"
    },
    "app/api/cron/**/route.ts": {
      "includeFiles": "certs/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/unordered-goods-weekly",
      "schedule": "0 6 * * 1"
    }
  ]
}
