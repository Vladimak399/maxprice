# Обязательные переменные для MAX webhook и служебных endpoint.
MAX_BOT_TOKEN=
MAX_WEBHOOK_SECRET=
ADMIN_SECRET=
CRON_SECRET=
PUBLIC_WEBHOOK_URL=

# Обязательна для статистики поставок, недельных отчётов, админки, HR-опросов и базы знаний.
DATABASE_URL=

# Основная и резервная vision-модели OpenRouter для скриншотов поступления.
OPENROUTER_VISION_MODEL=qwen/qwen3.7-flash
OPENROUTER_BACKUP_VISION_MODEL=google/gemini-3.5-flash-lite

# Временный выключатель распознавания скриншотов. При false изображения игнорируются без уведомлений об ошибках.
SCREENSHOT_OCR_ENABLED=true

# Куда отправлять итоговые отчеты по росту закупочной цены.
# Достаточно одной переменной: TARGET_CHAT_ID предпочтительнее для отдельного чата отчетов,
# TARGET_USER_ID — если отчеты должны приходить в личку.
TARGET_CHAT_ID=
TARGET_USER_ID=

# Включить временно, чтобы бот прислал chat_id неизвестного рабочего чата в TARGET_*.
ADMIN_NOTIFY_UNKNOWN_CHATS=false

# Рабочие чаты, из которых бот читает сообщения операторов.
# Пример:
# {"123456789":{"name":"Операторы цены","mode":"price_changes","enabled":true,"sendTo":"chat"}}
CHAT_CONFIGS_JSON=
